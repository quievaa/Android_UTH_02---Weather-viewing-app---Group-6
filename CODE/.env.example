# ==============================================================================
# ⚙️ MẪU CẤU HÌNH API KEY CHO DỰ ÁN THỜI TIẾT (WEATHER VIEWING APP - GROUP 6)
# ==============================================================================
# Bạn có thể dán trực tiếp API Key vào file:
# app/src/main/java/com/example/android_uth_02_weather_viewing_app_group6/data/remote/api/ApiConfig.kt
#
# Hoặc tham khảo các biến dưới đây:

# 1. API Key của OpenWeatherMap (Đăng ký miễn phí tại https://openweathermap.org/)
OPENWEATHER_API_KEY=""

# 2. API Key của WeatherAPI.com (Đăng ký miễn phí tại https://www.weatherapi.com/)
WEATHERAPI_KEY=""

# 3. Custom Server API URL (Nếu bạn có backend/proxy thời tiết riêng)
# Ví dụ: CUSTOM_API_URL="https://my-weather-api.com/v1/"
CUSTOM_API_URL=""
CUSTOM_API_KEY=""
CUSTOM_API_FORMAT="OPEN_WEATHER"
