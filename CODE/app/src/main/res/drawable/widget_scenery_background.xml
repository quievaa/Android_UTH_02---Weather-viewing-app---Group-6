<!-- Atmospheric Realistic Scenery Background (Dark Twilight Stormy Landscape) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#4A657A"
        android:centerColor="#263A4D"
        android:endColor="#121D28"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1.2dp"
        android:color="#4DFFFFFF" />
</shape>
